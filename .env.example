DATABASE_URL=postgres://postgres:password@localhost:5432/en_learner
JWT_SECRET=your-secret

# Optional SMTP config for sending group invitation emails.
# If SMTP_HOST is unset, invites are still created but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="en-learner <no-reply@en-learner.app>"
